    title: "QobuzProxy"
    abstract: "The software this fork is based on."
    authors:
      - name: "Leonardo Lobato and contributors"
    repository-code: "https://github.com/leolobato/qobuz-proxy"
    version: "1.7.6"
    license: MIT
  - type: software
    title: "StreamCore32"
    abstract: "Reverse-engineered Qobuz Connect protocol, including the DeviceType values."
    authors:
      - name: "Tobias Guyer"
    repository-code: "https://github.com/tobiasguyer/StreamCore32"
  - type: software
    title: "qonductor"
    abstract: "Rust implementation of Qobuz Connect that inspired making the device type configurable."
    authors:
      - alias: "nickblt"
    repository-code: "https://github.com/nickblt/qonductor"
  - type: software
    title: "qobuz-connect"
    abstract: "Documents the Qobuz web player's names for the device types."
    authors:
